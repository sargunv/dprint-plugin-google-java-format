{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "**/build",
    "**/.gradle",
    "**/.kotlin",
    "gradlew",
    "gradlew.bat",
    "mise.lock"
  ],
  "json": { "preferSingleLine": true },
  "markdown": { "textWrap": "always" },
  "ktfmt": { "style": "google", "lineWidth": 100 },
  "exec": {
    "commands": [
      {
        "command": "google-java-format - --assume-filename {{file_path}}",
        "exts": ["java"]
      }
    ]
  },
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/exec@0.8.0/plugin.json@9d6234ea05810c775f388c2a4cce82b9116b69294b65e0e1e9d64f1446283ef3",
    "https://plugins.dprint.dev/sargunv/ktfmt-0.65.0.json@d111be4dd67ed7d3fea905a23e29e8284c1db5389bb38b6a83e54055421b62e9"
  ]
}
